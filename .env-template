# Environment variables for the client app.
# Note that variables, that start with "VITE" prefix, are exposed to the public web.
# https://create-react-app.dev/docs/adding-custom-environment-variables

# Mandatory configuration
#
# Note: You also need to set Stripe secret key in Sharetribe Console.
#
VITE_SHARETRIBE_SDK_CLIENT_ID=change-me
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MAPBOX_ACCESS_TOKEN=

# If you are using a process with privileged transitions,
# Client Secret needs to be set too. The one related to Client ID.
# You get this at Sharetribe Console (Build -> Applications -> Add new).
SHARETRIBE_SDK_CLIENT_SECRET=

# Anthropic API key for AI listing generation (Claude Vision)
# Also used by the pool water temperature estimator (Haiku 4.5)
ANTHROPIC_API_KEY=

# ─── Weather (Tomorrow.io) ──────────────────────────────
# Used for pool-forecast endpoint + boost auto-pause on bad weather.
# Free tier: 25 calls/sec, 500/hour — more than enough with our caching.
# Get key: https://app.tomorrow.io/development/keys
TOMORROW_IO_API_KEY=

# ─── Stripe (boost + payments) ──────────────────────────
# STRIPE_SECRET_KEY drives live-mode boost purchase. When unset, boost
# purchase runs in mock mode (no charge, boost is applied immediately).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Sharetribe Integration API ─────────────────────────
# Separate from the Marketplace API credentials above. Required for
# cross-host writes (e.g. beacon stat writes to listings the current
# visitor does NOT own). When unset, beacon falls back to log-only mode.
SHARETRIBE_INTEGRATION_CLIENT_ID=
SHARETRIBE_INTEGRATION_CLIENT_SECRET=

# ─── External ad channels (phase 1b, all optional) ──────
# Pooled MCC account — PRNM runs one master Google Ads account and
# Smart Bidding optimizes across every boosted host's listings.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MCC_ID=
GOOGLE_ADS_REFRESH_TOKEN=

# Meta (Facebook/Instagram) Marketing API.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=

# Microsoft Advertising (Bing). Cheapest CPC in pool rental vertical.
BING_DEVELOPER_TOKEN=
BING_CUSTOMER_ID=
BING_ACCOUNT_ID=

# Or set up an alternative map provider (Google Maps). Check documentation.
# VITE_GOOGLE_MAPS_API_KEY=

# Defaults
#

# Host/domain - don't use trailing slash: "/"
VITE_MARKETPLACE_ROOT_URL=http://localhost:3000

# Marketplace name
# If not set, this defaults to 'Biketribe' in src/config/configDefault.js
VITE_MARKETPLACE_NAME=

# Social logins && SSO
# If the app or client id is not set the auhtentication option is not shown in the Template
VITE_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This is overwritten by configuration in .env.development and
# .env.test. In production deployments use env variable and set it to
# 'production'
VITE_ENV=production

# CSP. You can use value 'report' or 'block'.
# If the env varibale is missing, csp is disabled.
VITE_CSP=report

# Options. Uncomment and set to test.
#

# VITE_SHARETRIBE_USING_SSL=true
# SERVER_SHARETRIBE_TRUST_PROXY=true
# VITE_SENTRY_DSN=change-me
# BASIC_AUTH_USERNAME=sharetribe
# BASIC_AUTH_PASSWORD=secret

# This is GA4 id, which should start with 'G-' prefix.
# You should also turn "Enhanced measurements" off from GA.
# https://support.google.com/analytics/answer/9216061
# VITE_GOOGLE_ANALYTICS_ID=change-me

# This adds data-domains for Plausible script
# If you add this environment variable, you should have created an account in plausible.io
# You can add multiple domains separated by comma.
# E.g. VITE_PLAUSIBLE_DOMAINS=example1.com,example2.com
# VITE_PLAUSIBLE_DOMAINS=my.marketplace.com

# Debugging and reducing load from server
# PREVENT_DATA_LOADING_IN_SSR=true

# Enable legacy browser support. It should be used only on production sites.
# You can skip this in development/staging/test sites.
VITE_LEGACY_BROWSER_SUPPORT=true
