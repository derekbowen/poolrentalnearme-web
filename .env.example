# ========================================================================
# Server hardening
# ========================================================================

# HTTP basic-auth password for non-production hosts.
# (optional)
BASIC_AUTH_PASSWORD=

# (optional) used by server/config/server.js
BASIC_AUTH_USERNAME=

# (optional) used by server/config/csp.js
CSP_REPORT_URL=

# ========================================================================
# Staff routing
# ========================================================================

# (optional) used by server/concierge/config.js
BRANDON_PHONE=

# (optional) used by server/config/staff.js
PRNM_BRANDON_PHONE=

# ========================================================================
# Found by scripts/check-env-documented.js (2026-09-03)
# ========================================================================
# These are read by code but were missing from the original template. Three of
# them were wrongly classified as false positives in the first audit pass, and
# TOMORROW_IO_API_KEY was wrongly called stale — server/services/weather.js
# reads it. The documentation checker now prevents this class of drift.

# JWKS key id, read as `const { KEY_ID: keyId } = process.env` in
# server/wellKnownRouter.js. Identifies the signing key in the published JWKS.
# (optional)
KEY_ID=

# Sharetribe marketplace id used by the RabbitMQ event-handler subscriber
# (server/extensions/event-handler/common/config/rabbitmq.js). Only needed if
# the event handler is actually running — see the dependency map.
# (optional)
MARKETPLACE_ID=

# Max HTTP sockets for the Sharetribe SDK agent (server/api-util/sdk.js).
# Defaults to 10 when unset.
# (optional)
MAX_SOCKETS=

# Tomorrow.io API key for the weather/forecast service
# (server/services/weather.js). Without it the forecast is skipped and a warning
# is logged — a graceful, correctly-classified optional degradation.
# (optional)
TOMORROW_IO_API_KEY=

# ========================================================================
# Operational flags added 2026-09-03
# ========================================================================

# Set to "true" to make the server REFUSE TO START when a production-critical
# variable is missing, instead of logging the startup banner and continuing.
# Default (unset) is loud-but-not-fatal: deployments are already blocked by
# scripts/preflight-production.js, and a crash-loop on an unreachable box trades
# a silent subsystem for a total outage. Turn this on once production has been
# verified clean. See server/startupEnvCheck.js.
# (optional)
PRNM_STRICT_ENV=

# EAST (fresh-web) names for the Sharetribe Integration credential. The
# marketplace reads SHARETRIBE_INTEGRATION_SDK_CLIENT_ID/_SECRET; the marketing
# host uses these shorter names for the same credential. check-env.js,
# smoke-test-production.js and server/startupEnvCheck.js accept either spelling
# so one tool works on both hosts.
# (optional — only on EAST)
SHARETRIBE_INTEG_CLIENT_ID=
# (optional — only on EAST)
SHARETRIBE_INTEG_CLIENT_SECRET=
