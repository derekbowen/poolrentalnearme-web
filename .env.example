# (optional) used by server/extensions/wishlist/common/config/wishlist.js
VITE_JH_WISHLIST_FEATURE_ENABLE_BOOKMARK_OWN_LISTING=

# (optional) used by src/extensions/wishlist/config/configWishlist.js
VITE_JH_WISHLIST_FEATURE_ENABLE_USER_NAV_ITEM=

# (optional) used by src/config/configDefault.js
VITE_MARKETPLACE_NAME=

# (optional) used by server/extensions/phone-number-verification/config/otp.js
VITE_OTP_WINDOW=

# (optional) used by server/config/server.js
VITE_PORT=

# ========================================================================
