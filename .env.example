# (optional) used by server/api-util/idToken.js
VITE_DEV_API_SERVER_PORT=

# (optional) used by src/extensions/hero/config.js
VITE_HERO_BACKGROUND_VIDEO_URL=

# (optional) used by src/containers/HostOnboardingPage/previewAccess.js
VITE_HOST_PREVIEW_OPERATOR_IDS=

# (optional) used by src/extensions/intercom/config/intercom.js
