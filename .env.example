# PRNM marketplace — canonical environment variable reference.
#
# Names and explanations only. NEVER commit real values: .gitignore blocks .env and
# .env.* — keep this file (.env.example) as the only tracked one.
#
# Generated 2026-09-03 from a full scan of the repository. Variables marked REQUIRED are
# production-critical: the marketplace fails to boot, or a booking/money/notification path
# breaks silently, without them. Validate with: node scripts/check-env.js
#
# VITE_* are BUILD-TIME. They are baked into the client bundle by `vite build`; setting one
# only in the running container has no effect.

# ========================================================================
# Stripe
# ========================================================================

# Stripe secret key. Read-only payout + Identity use here; today this is a RESTRICTED key 
# (rk_live_). Payments themselves run through Sharetribe's own Stripe connection, not this
#  key.
# (REQUIRED)
STRIPE_SECRET_KEY=

# Stripe publishable key (safe in the browser bundle).
# (REQUIRED)
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Identity verification flow id used by create-verification-session.
# (optional)
STRIPE_IDENTITY_RENTAL_FLOW_ID=

# ========================================================================
# Sharetribe
# ========================================================================

# Sharetribe INTEGRATION API client id. NOTE: EAST/fresh-web calls this SHARETRIBE_INTEG_C
# LIENT_ID. Same credential, two names.
# (REQUIRED)
SHARETRIBE_INTEGRATION_SDK_CLIENT_ID=

# Sharetribe INTEGRATION API client secret. EAST calls this SHARETRIBE_INTEG_CLIENT_SECRET
# .
# (REQUIRED)
SHARETRIBE_INTEGRATION_SDK_CLIENT_SECRET=

# Sharetribe Marketplace API client secret (server only).
# (REQUIRED)
SHARETRIBE_SDK_CLIENT_SECRET=

# Sharetribe Marketplace API client id (public, baked into the bundle).
# (REQUIRED)
VITE_SHARETRIBE_SDK_CLIENT_ID=

# BUILD-TIME. Controls the Secure flag on session cookies. Setting it only in the containe
# r does nothing — it must be present at vite build. This aborted release c158.
# (REQUIRED)
VITE_SHARETRIBE_USING_SSL=

# (optional) used by server/api-util/sdk.js
VITE_SHARETRIBE_SDK_ASSET_CDN_BASE_URL=

# Sharetribe API base URL. Defaults to flex-api.sharetribe.com if unset.
# (optional)
VITE_SHARETRIBE_SDK_BASE_URL=

# (optional) used by src/config/settings.js
VITE_SHARETRIBE_SDK_LOGIN_AS_BASE_URL=

# (optional) used by server/api-util/sdk.js
VITE_SHARETRIBE_SDK_TRANSIT_VERBOSE=

# ========================================================================
# Supabase
# ========================================================================

# Supabase service-role key. Full read/write, bypasses RLS. Server only — never expose to 
# the browser.
# (REQUIRED)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project URL for the content/ops database.
# (REQUIRED)
SUPABASE_URL=

# ========================================================================
# Twilio / SMS
# ========================================================================

# Twilio account SID.
# (REQUIRED)
TWILIO_ACCOUNT_SID=

# Twilio auth token. Also used to validate inbound webhook signatures.
# (REQUIRED)
TWILIO_AUTH_TOKEN=

# Twilio sender number (fallback when no Messaging Service is set).
# (REQUIRED)
TWILIO_PHONE_NUMBER=

# (optional) used by server/extensions/sms-messaging/mod/notify/betablast.js
BLAST_DRY_RUN=

# (optional) used by server/extensions/sms-messaging/mod/notify/betablast.js
BLAST_THROTTLE_MS=

# (optional) used by server/config/staff.js
CAMPAIGN_FORWARD_TO=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_BODY=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_DELAY_MS=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_ENABLED=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_MAX_AGE_MS=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_QUIET_END=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_QUIET_START=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_SWEEP_MS=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_TABLE=

# (optional) used by server/extensions/sms-messaging/mod/notify/welcome.js
FOUNDER_WELCOME_USERTYPE=

# (optional) used by server/extensions/sms-messaging/mod/notify/poller.js
ONBOARD_NUDGE_ENABLED=

# (optional) used by server/extensions/sms-messaging/mod/notify/poller.js
PAYOUT_SMS_ENABLED=

# (optional) used by server/extensions/sms-messaging/mod/notify/replyactions.js
REPLY_TO_ACCEPT_ENABLED=

# (optional) used by server/extensions/sms-messaging/mod/notify/poller.js
SMS_ALARM_PHONE=

# (optional) used by server/extensions/sms-messaging/mod/notify/poller.js
SMS_ALLOWLIST=

# (optional) used by server/extensions/sms-messaging/mod/notify/poller.js
SMS_NOTIFICATIONS_ENABLED=

# (optional) used by server/extensions/sms-messaging/mod/notify/poller.js
SMS_POLL_INTERVAL_MS=

# (optional) used by server/extensions/sms-messaging/mod/notify/inbound.js
TWILIO_INBOUND_URL=

# Twilio Messaging Service SID. Preferred sender — gives Advanced Opt-Out.
# (optional)
TWILIO_MESSAGING_SERVICE_SID=

# Set to false ONLY in local dev to skip inbound webhook signature checks.
# (optional)
TWILIO_VALIDATE_SIGNATURE=

# (optional) used by scripts/switchy/weekly_stats.js
WEEKLY_DRY=

# ========================================================================
# JWT / signing keys
# ========================================================================

# Private key for the encrypted-JWT login-as flow.
# (optional)
ENCRYPTED_JWT_PRIVATE_KEY=

# RSA private key served by the well-known JWKS route.
# (optional)
RSA_PRIVATE_KEY=

# RSA public key for the JWKS route.
# (optional)
RSA_PUBLIC_KEY=

# Matching public key (browser side).
# (optional)
VITE_ENCRYPTED_JWT_PUBLIC_KEY=

# ========================================================================
