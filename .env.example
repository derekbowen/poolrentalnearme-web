VITE_MARKETPLACE_ROOT_URL=

# (optional) used by server/wellKnownRouter.js
ANDROID_APP_PACKAGE_NAME=

# (optional) used by server/wellKnownRouter.js
ANDROID_APP_SHA_256_FINGERPRINT=

# (optional) used by server/wellKnownRouter.js
APPLE_BUNDLE_ID=

# (optional) used by server/wellKnownRouter.js
APPLE_TEAM_ID=

# (optional) used by server/concierge/lib/webhook.js
AUTH_TOKEN=

# (optional) used by server/config/server.js
BASE=

# (optional) used by scripts/deploy.sh
CURRENT_AWS_INSTANCE_URL=

# (optional) used by server/api-util/sdk.js
NODE_ENV=

# (optional) used by server/extensions/phone-number-verification/config/otp.js
OTP_TIME_STEP=

# (optional) used by server/config/server.js
PORT=

