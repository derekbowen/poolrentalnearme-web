# (optional) used by scripts/deploy.sh
AWS_ENV_USER_REGION=

# Deploy-time AWS secret for the same.
# (optional)
AWS_ENV_USER_SECRET_ACCESS_KEY=

# (optional) used by scripts/deploy.sh
AWS_INSTANCE_URL=

# (optional) used by scripts/deploy.sh
AWS_INSTANCE_URLS=

# Name of the AWS Secrets Manager secret holding the real runtime .env.
