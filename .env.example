AWS_ACCOUNT_ID=

# (optional) used by scripts/deploy.sh
AWS_ECR_REGION=

# (optional) used by scripts/deploy.sh
AWS_ECR_REPO_URL=

# Deploy-time AWS key used by scripts/deploy.sh to pull the env file from Secrets Manager.
