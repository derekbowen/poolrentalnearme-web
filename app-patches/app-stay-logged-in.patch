+    // A throw here reads as "no session" to every caller, so an unreadable or
+    // half-written entry would silently sign the user out. Swallow it and let
+    // the SDK fall back to the anonymous flow instead of losing the session.
+    try {
+      final token = await _flutterSecureStorageFacade.read(key: _clientId);
+      if (token == null) {
+        return null;
+      }
