+++ b/common/lib/services/flutter_secure_storage/flutter_secure_storage.dart
@@ -3,9 +3,24 @@ import 'package:riverpod_annotation/riverpod_annotation.dart';
 
 part 'flutter_secure_storage.g.dart';
 
+// Android: the default backend keeps an RSA key in the Android Keystore, which
+// is invalidated by OS upgrades and backup/restore - reads then return null and
+// the user is silently signed out. EncryptedSharedPreferences survives both.
+//
+// iOS/macOS: the default accessibility is `unlocked`, so a read fails whenever
+// the app starts before the device's first unlock (push wake, background
+// refresh, restart). `first_unlock` stays readable from then on, and
+// `ThisDeviceOnly` keeps the token out of iCloud Keychain backups.
+const _androidOptions = AndroidOptions(encryptedSharedPreferences: true);
+const _iosOptions =
+    IOSOptions(accessibility: KeychainAccessibility.first_unlock_this_device);
+
 @Riverpod(keepAlive: true)
 FlutterSecureStorage _flutterSecureStorage(_FlutterSecureStorageRef ref) {
-  return const FlutterSecureStorage();
+  return const FlutterSecureStorage(
+    aOptions: _androidOptions,
+    iOptions: _iosOptions,
+  );
 }
 
 @Riverpod(keepAlive: true)
