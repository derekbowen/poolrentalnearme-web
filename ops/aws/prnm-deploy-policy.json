{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunCommandsOnPrnmServersOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-west-1:783764596813:instance/i-0a711c88043788b2b",
        "arn:aws:ec2:us-east-1:783764596813:instance/i-060692efd53e6e853",
        "arn:aws:ec2:us-west-1:783764596813:instance/i-0c5a4f9c653c3bc82",
        "arn:aws:ssm:us-west-1::document/AWS-RunShellScript",
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommands", "ssm:ListCommandInvocations", "ssm:DescribeInstanceInformation"],
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyInventoryAndCost",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "cloudwatch:GetMetricStatistics", "ce:Get*"],
      "Resource": "*"
    },
    {
      "Sid": "StopStartTestServerOnly",
      "Effect": "Allow",
      "Action": ["ec2:StopInstances", "ec2:StartInstances"],
      "Resource": "arn:aws:ec2:us-west-1:783764596813:instance/i-0c5a4f9c653c3bc82"
    }
  ]
}
