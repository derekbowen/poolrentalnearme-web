# Copy to a mode-600 file OUTSIDE the repo (e.g. /home/ubuntu/prnm-bot/.env), fill in, never commit.
# Values come from the Chatwoot setup runner (bot token + secret are printed to that file, never to a terminal).
CHATWOOT_URL=http://127.0.0.1:3009
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_DEREK_USER_ID=
CHATWOOT_BRANDON_USER_ID=
CHATWOOT_PUBLIC_URL=https://chat.poolrentalnearme.com
CHATWOOT_FORWARDED_PROTO=https
SITE_URL=https://www.poolrentalnearme.com
PORT=3021
HOST=127.0.0.1
BOT_DATA_DIR=/home/ubuntu/prnm-bot/data
