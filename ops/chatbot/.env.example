# Copy to /home/ubuntu/chatbot/.env (mode 600, outside any git checkout), fill in, never commit.
# ops/chatbot/ops/cw_setup.py writes this file on EAST; values are never printed to a terminal.
CHATWOOT_URL=http://127.0.0.1:3009
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_DEREK_USER_ID=
CHATWOOT_BRANDON_USER_ID=
CHATWOOT_PUBLIC_URL=https://chat.poolrentalnearme.com
CHATWOOT_FORWARDED_PROTO=https
SITE_URL=https://www.poolrentalnearme.com
PORT=3120
HOST=127.0.0.1
BOT_DATA_DIR=/home/ubuntu/chatbot/data
# Optional: handoff flood caps (defaults: 1 per conversation and 2 per contact per 24 h, 10 per hour overall)
# BOT_CAP_PER_CONVERSATION=1
# BOT_CAP_PER_CONTACT=2
# BOT_CAP_GLOBAL_PER_HOUR=10
