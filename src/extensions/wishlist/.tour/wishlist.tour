    {
      "file": "src/components/UserNav/UserNav.js",
      "description": "Add a new object for showing `My Wishlist` on `UserNav`\n\n```jsx\n{\n  text: <FormattedMessage id=\"UserNav.myWishlistLink\" />,\n  selected: currentPage === 'WishlistPage',\n  linkProps: {\n    name: 'WishlistPage',\n  },\n},\n\n```",
